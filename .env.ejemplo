# Copiá este archivo a .env y completá el valor.
#
# SECRET es el token que tienen que mandar los clientes en el header
# X-API-Key para poder consultar el asistente.
#
# Generá uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Después de cambiarlo, hay que volver a cargarlo en n8n:
#   node cargar-credencial.mjs && docker restart n8n

SECRET=
